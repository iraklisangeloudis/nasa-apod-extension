{
    "manifest_version": 3,
    "name": "NASA APOD Viewer",
    "version": "1.1.0",
    "description": "View the Astronomy Picture of the Day from NASA.",
    "permissions": ["storage"],
    "host_permissions": ["https://science.nasa.gov/*"],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'; frame-src https://www.youtube-nocookie.com https://player.vimeo.com;"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/nasa16.png",
        "48": "icons/nasa48.png",
        "128": "icons/nasa128.png"
      }
    },
    "icons": {
      "16": "icons/nasa16.png",
      "48": "icons/nasa48.png",
      "128": "icons/nasa128.png"
    }
  }
